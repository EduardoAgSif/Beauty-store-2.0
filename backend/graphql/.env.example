# Élvi GraphQL API — Variables de Entorno
# Copia este archivo como .env y ajusta los valores

# ─── MySQL / phpMyAdmin (XAMPP) ─────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=app_db
DB_USER=root
DB_PASSWORD=

# ─── Servidor ───────────────────────────────────────────────
PORT=4000

# ─── JWT ────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=7d
